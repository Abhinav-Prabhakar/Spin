{
  "name": "spin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimalist room for listening to music together.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c dim,cyan \"wrangler dev --port 8790\" \"vite\"",
    "dev:api": "wrangler dev --port 8790",
    "dev:web": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages --outDir docs && node scripts/pages-postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "music-metadata": "^12.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
